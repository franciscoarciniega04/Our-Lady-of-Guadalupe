# Server-only. Never commit real values. Hosted values go into Sites environment settings.
APP_URL=https://your-site.example
SUPABASE_URL=https://your-project.supabase.co
# Recommended current keys (Settings > API Keys).
SUPABASE_PUBLISHABLE_KEY=
SUPABASE_SECRET_KEY=
# Optional legacy aliases; use these only for an existing project with JWT keys.
SUPABASE_ANON_KEY=
SUPABASE_SERVICE_ROLE_KEY=
# Used only by deployment/migrations/backups, never the browser.
DATABASE_URL=postgresql://USER:PASSWORD@HOST:5432/postgres?sslmode=require
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=
HCAPTCHA_SITE_KEY=
HCAPTCHA_SECRET=
FILE_SCANNER_URL=
FILE_SCANNER_TOKEN=
LEGAL_APPROVED=false
LEGAL_VERSION=1
# Optional central log intake URL and bearer token; provision alert rules separately.
LOG_INGEST_URL=
LOG_INGEST_TOKEN=
# Backup destination and encryption (CI secrets only).
BACKUP_BUCKET=
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_REGION=
BACKUP_AGE_RECIPIENT=
# Bootstrap: UUID of a verified existing Supabase Auth account, no password in scripts.
SUPER_ADMIN_USER_ID=
